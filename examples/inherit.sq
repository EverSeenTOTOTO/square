; --- helpers ---

[let foreach /[v fn] [begin
  [let i 0]
  [while [< i [len v]]
    [fn [at v i]]
    [= i [+ i 1]]]]]

[let in /[k o] [!= [get o k] nil]]

; --- impl ---

; create class
[let class /[members templates proto] [begin
  [let clz [obj]]
  [foreach [keys members] /[k] [set proto k [get members k]]]

  [= clz.prototype proto]

  ; create instance
  [= clz.new /[] [begin
    [let instance [obj]]
    [= instance.__proto__ clz.prototype]

    [foreach [keys templates] /[k] [set instance k [get templates k]]]

    ; search across chain
    [proxy instance
      'get' /[t k]
              [if [in k t]
                [get t k]
                [get instance.__proto__ k]]]]]
  clz]]

; create derived class
[let extends /[clazz overrides templates] [class overrides templates [clazz.new]]]

[let instanceof /[o clazz] [begin
  [let proto o.__proto__]
  [let r [callcc /[break]
    [while proto
      [if [== proto clazz.prototype]
        [break true]
        [= proto proto.__proto__]]]]]
  [if [== r true] true false]]]

; --- usage ---

[let Base [class  
            [obj
              'x' [obj 'value' 42]
              'foo' /[] [println this.x.value]
              'bar' /[] [println 'bar']]

            [obj 'y' 'hello']

            [obj]]]

[let Derived [extends Base [obj 'bar' /[] [println 'override bar']] [obj]]]

[let a [Base.new]]
[let b [Derived.new]]

[a.foo] ; 42
[a.bar] ; bar

[b.foo] ; 42
[b.bar] ; override bar

[println b.x] ; [42]
[println b.y] ; hello

[= Base.prototype.foo /[] [println -this.x.value]]

[a.foo] ; -42
[b.foo] ; -42

[= b.x.value 24]
[= b.y 'world']

[println a.x] ; [24]
[println a.y] ; hello

[println [instanceof a Base]]     ; true
[println [instanceof b Base]]     ; true
[println [instanceof a Derived]]  ; false
[println [instanceof b Derived]]  ; true
