; --- helpers ---

[let foreach /[v fn] [begin
  [let i 0]
  [while [< i [len v]]
    [fn [at v i]]
    [= i [+ i 1]]]]]

[let in /[k o] [!= [get o k] nil]]

; --- impl ---

; create class
[let class /[members proto] [begin
  [let o [obj]]
  [foreach [keys members] /[k] [set proto k [get members k]]]
  [= o.prototype proto]
  o]]

; create instance
[let new /[clazz] [begin
  [let o [obj]]
  [= o.__proto__ clazz.prototype]
  [proxy o
    'get' /[t k]
            [if [in k t]
              [get t k]
              [get o.__proto__ k]]]]]

; create derived class
[let extends /[clazz overrides] [class overrides [new clazz]]]

[let instanceof /[o clazz] [begin
  [let proto o.__proto__]
  [let r [callcc /[break]
    [while proto
      [if [== proto clazz.prototype]
        [break true]
        [= proto proto.__proto__]]]]]
  [if [== r true] true false]]]

; --- usage ---

[let Base [class [obj
                  'x' 42
                  'foo' /[] [println this.x]
                  'bar' /[] [println 'bar']]
                  [obj]]]

[let Derived [extends Base [obj 'bar' /[] [println 'override bar']]]]

[let a [new Base]]
[let b [new Derived]]

[a.foo] ; 42
[a.bar] ; bar

[b.foo] ; 42
[b.bar] ; override bar

[= Base.prototype.foo /[] [println -this.x]]

[a.foo] ; -42
[b.foo] ; -42

[println [instanceof a Base]]     ; true
[println [instanceof b Base]]     ; true
[println [instanceof a Derived]]  ; false
[println [instanceof b Derived]]  ; true
