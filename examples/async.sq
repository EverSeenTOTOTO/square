; 运行：./sq examples/async.sq

[spawn /[] [begin [sleep 400] [println 'task A done']]]
[spawn /[] [begin [sleep 600] [defer /[] [println 'task B done']]]] ; defer is microtask
[spawn /[] [begin [sleep 800] [println 'task C done']]]

[defer /[] [begin
  [defer /[] [begin
    [println 'later']
    [defer /[] [println 'latest']]]]
  [println 'first']]]

[println 'sync']
